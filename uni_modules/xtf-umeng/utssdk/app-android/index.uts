import UMConfigure from "com.umeng.commonsdk.UMConfigure";

import MobclickAgent from  "com.umeng.analytics.MobclickAgent";
import PageMode from "com.umeng.analytics.MobclickAgent.PageMode"
import HashMap from "java.util.HashMap";
import Map from "java.util.Map";
import OnGetOaidListener from  "com.umeng.commonsdk.listener.OnGetOaidListener";

 const preUMInit=function(key:string,channel:string){
	 UMConfigure.preInit(UTSAndroid.getAppContext()!,key,channel);
}

