	public async saveCourse(data: CourseParams): Promise<UTSJSONObject> {
		// @ts-ignore
		const result = await Manager.getWebService().saveCourse(UTSAndroid.getAppContext()!,data.course, data.hideRule).toJSONString();
		return parseUTSResponse(result)
	}
	public async deleteCourse(data: DeleteCourse): Promise<UTSJSONObject> {
		// @ts-ignore
		const result = await Manager.getWebService().deleteCourse(UTSAndroid.getAppContext()!,data.courseId, data.isSystem, data.day,data.start).toJSONString();
		return parseUTSResponse(result)
	}
