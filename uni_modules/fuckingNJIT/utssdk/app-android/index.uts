	/**
	 * 获取智能决策看板数据
	 */
	public async getDashboardInsight(): Promise<DashboardInsightResponse> {
		try {
			// 1. 直接 await 底层的 suspend 函数，拿到的是 JSON 字符串
			const resString = await Manager.getDashboardInsight();
			// @ts-ignore
			const resObj = JSON.parse<DashboardResultWrapper>(resString);

			// 3. 安全判空与提取
			if (resObj != null && resObj.code == 200) {
				return resObj.data;
			} else {
				return {};
			}
		} catch (error) {
			// 捕获到底层抛出的任何异常
			return Promise.reject(error);
		}
	}
}