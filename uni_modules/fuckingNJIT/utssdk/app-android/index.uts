	public requestKeepAliveNormalPermissions() : Promise<Array<string>>{
		return new Promise((resolve, reject) => {
			// @ts-ignore
			Manager.getPermissionsManager(UTSAndroid.getUniActivity()!).requestKeepAliveNormalPermissions((isGranted: boolean,list: List<String>) => {
				if (isGranted) {
					resolve(Array<string>())
				} else {
					// @ts-ignore
					reject(Array.fromNative(list))
				}
			})
		})
	}

