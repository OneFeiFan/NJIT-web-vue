	public checkInstallPackagePermission() : boolean {
		// @ts-ignore
		return Manager.getPermissionsManager(UTSAndroid.getUniActivity()!).checkRequestInstallPackage()
	}
	public requestInstallPackage() : Promise<boolean> {
		return new Promise((resolve, reject) => {
			// @ts-ignore
			Manager.getPermissionsManager(UTSAndroid.getUniActivity()!).requestRequestInstallPackage((isGranted: boolean) => {
				if (isGranted) {
					resolve(true)
				} else {
					reject(false)
				}
			})
		})
	}

