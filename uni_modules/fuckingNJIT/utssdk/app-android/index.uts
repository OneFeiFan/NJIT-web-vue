	public async getDashboardInsight(): Promise<DashboardInsightResponse> {
		// @ts-ignore
		const data = await DecisionFacade.getDashboardInsight(UTSAndroid.getAppContext()!).toJSONString();
		const tmp = parseUTSResponse(data)
		if(tmp.contains('code') && tmp['code'] == 200.0){
			return tmp['data']
		}else{
			this.showToast("健康数据获取失败")
			return {}
		}
	}
