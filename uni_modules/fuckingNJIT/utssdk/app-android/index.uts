// @ts-ignore
import PortalManager from "com.feifan.fuckingnjit.utils.wifiauth.PortalManager";

function parseUTSResponse(data: string): UTSJSONObject | Error {
	try {
    	// 使用 JSON.parseObject 进行解析
		const result = JSON.parse(data);
    	
    	// 检查解析结果是否为空（可能是因为 JSON 字符串格式错误）
    	if (result === null) {
    	    throw new Error("数据解析失败：JSON格式可能不正确或数据为空");
    	}
    	return result;
		// @ts-ignore
	} catch (e: Error) {
    	return e
    }
}

export class Core {

	public showToast(str : string) {
		Manager.showToast(str);
	}

	public startLogin(relogin : boolean) {
		Manager.startLogin(relogin)
	}
	

	public async getCurriculum(refresh : boolean) : Promise<UTSJSONObject> {
		return JSON.parse(await Manager.getUserManager().getCurriculum(refresh)) ?? {}
	}

	public getAllUsers() : string {
		return Manager.getUserManager().getAllUsers()
	}

	public setCurrentUser(id : string) {
		return Manager.getUserManager().setCurrentUser(id)
	}

	public async deleteUser(id : string) : Promise<boolean> {
		return await Manager.getUserManager().deleteUser(id)
	}

	public async getEmptyClassrooms(dateRange : string, coursePeriod : string, buildingId : string) : Promise<string> {
		return await Manager.getWebService().getEmptyClassrooms(dateRange, coursePeriod, buildingId)
	}
	public async getSorces(xnm:String,xqm:String,refresh : boolean) : Promise<string> {
		return await Manager.getUserManager().getUserScores(xnm,xqm,refresh)
	}
	
	public async getSorcesDetail(classId : string, schoolYear : string, semester : string, courseName : string) : Promise<UTSJSONObject | Error> {
		const data = await Manager.getWebService().getSorcesDetail(classId, schoolYear, semester, courseName).toJSONString();
		return parseUTSResponse(data)
	}
	public async getNoticeInformation() : Promise<UTSJSONObject | Error> {
		const data = await Manager.getWebService().getNoticeInformation().toJSONString();
		return parseUTSResponse(data)
	}

	public async getAcademicProgress(refresh : boolean) : Promise<UTSJSONObject | Error> {
		const data = await Manager.getUserManager().getAcademicProgress(refresh).toJSONString();
		return parseUTSResponse(data)
	}
	
	public async saveCourse(data: CourseParams): Promise<UTSJSONObject | Error> {
		const result = await Manager.getWebService().saveCourse(data.course, data.hideRule).toJSONString();
		return parseUTSResponse(result)
	}
	public async deleteCourse(data: DeleteCourse): Promise<UTSJSONObject | Error> {
		const result = await Manager.getWebService().deleteCourse(data.courseId, data.isSystem, data.day,data.start).toJSONString();
		return parseUTSResponse(result)
	}
	public async restoreCourse(data: RestoreCourse): Promise<UTSJSONObject | Error> {
		const result = await Manager.getWebService().restoreCourse(data.courseId, data.day,data.start).toJSONString();
		return parseUTSResponse(result)
	}
