function parseUTSResponse(data: string): UTSJSONObject{
	try {
    	// 使用 JSON.parseObject 进行解析
		const result = JSON.parse(data);
    	
    	// 检查解析结果是否为空（可能是因为 JSON 字符串格式错误）
    	if (result === null) {
    	    throw new Error("数据解析失败：JSON格式可能不正确或数据为空");
    	}
    	return result as UTSJSONObject;
		// @ts-ignore
	} catch (e: Error) {
		console.log(e)
    	return new UTSJSONObject()
    }
}

export class Core {

	public showToast(str : string) {
		// @ts-ignore
		SystemActionHelper.showToast(UTSAndroid.getAppContext()!, str);
	}

	public startLogin(relogin : boolean) {
		// @ts-ignore
		SystemActionHelper.startLogin(UTSAndroid.getAppContext()!, relogin)
	}


	public async getCurriculum(refresh: boolean): Promise<UTSJSONObject> {
		// @ts-ignore
		const data = await Manager.getUserManager().getCurriculum(UTSAndroid.getAppContext()!, refresh).toJSONString();
		const tmp = parseUTSResponse(data)
		if(tmp.contains('code') && tmp['code'] == 200.0){
			return tmp['data']
		}else{
			this.showToast("课表获取失败")
			return new UTSJSONObject()
		}
	}

	public getAllUsers() : string {
		// @ts-ignore
		return Manager.getUserManager().getAllUsers(UTSAndroid.getAppContext()!)
	}

	public setCurrentUser(id : string) {
		// @ts-ignore
		return Manager.getUserManager().setCurrentUser(UTSAndroid.getAppContext()!, id)
	}

	public async deleteUser(id : string) : Promise<boolean> {
		// @ts-ignore
		return await Manager.getUserManager().deleteUser(UTSAndroid.getAppContext()!, id)
	}

	public async getEmptyClassrooms(dateRange: string, coursePeriod: string, buildingId: string): Promise<UTSJSONObject> {
		// @ts-ignore
		const data = await Manager.getWebService().getEmptyClassrooms(UTSAndroid.getAppContext()!, dateRange, coursePeriod, buildingId).toJSONString();
		const tmp = parseUTSResponse(data)
		if(tmp.contains('code') && tmp['code'] == 200.0){
			return tmp['data']
		}else{
			this.showToast("空教室获取失败")
			return new UTSJSONObject()
		}
	}

	public async getSorces(xnm: String, xqm: String, refresh: boolean): Promise<UTSJSONObject> {
		// @ts-ignore
		const data = await Manager.getUserManager().getUserScores(UTSAndroid.getAppContext()!, xnm, xqm, refresh).toJSONString();
		const tmp = parseUTSResponse(data)
		if(tmp.contains('code') && tmp['code'] == 200.0){
			return tmp.toJSONString() // 直接返回data，或者tmp['data']会
		}else{
			this.showToast("成绩获取失败")
			return new UTSJSONObject()
		}
	}

	public async getSorcesDetail(classId : string, schoolYear : string, semester : string, courseName : string) : Promise<UTSJSONObject> {
		// @ts-ignore
		const data = await Manager.getWebService().getSorcesDetail(UTSAndroid.getAppContext()!, classId, schoolYear, semester, courseName).toJSONString();
		return parseUTSResponse(data)
	}
